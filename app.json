{
  "expo": {
    "name": "rutago-mobile",
    "slug": "rutago-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rutagomobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.rutago.mobile",
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.rutago.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "RutaGo usa Face ID para verificar tu identidad al iniciar sesión."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "RutaGo usa tu ubicación para reportar el avance del viaje a los pasajeros.",
          "locationAlwaysPermission": "RutaGo usa tu ubicación en segundo plano para seguir reportando el viaje.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "7a16dc33-1f2e-42ac-b0dd-b5b759d07e81"
      }
    },
    "owner": "mr.angel"
  }
}
