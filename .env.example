# URL pública del backend RutaGo (sin /api; el cliente añade /api).
# En Expo, sólo las variables EXPO_PUBLIC_ se incluyen en el bundle.
EXPO_PUBLIC_API_URL=https://rutago-backend-a303.onrender.com

# Para probar un backend local desde el celular con túnel, usa `npm run start:tunnel`
# y reemplaza la URL pública por la de ngrok/Cloudflare, por ejemplo:
# EXPO_PUBLIC_API_URL=https://TU-TUNNEL.ngrok-free.app

# Para probar el enlace de recuperación en el celular, configura en el backend:
# PASSWORD_RESET_URL=rutagomobile://recuperar-password
# Ver rutago-backend/.env.example. Nunca pongas secretos aquí.
